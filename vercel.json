{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "rewrites": [
    {
      "source": "/arolinks/:id/:filename*",
      "destination": "/api/redirect?id=:id&filename=:filename*"
    },
    {
      "source": "/arolinks/:id",
      "destination": "/api/redirect?id=:id"
    }
  ]
}
